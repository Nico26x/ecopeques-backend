    {
      "name": "01 - HU-01 Registro Tutor",
      "item": [
        {
          "name": "Registro exitoso PADRE",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = `tutor${Date.now()}@ecopeques.com`;",
                  "pm.environment.set('unique_email', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('AuthResponse contiene token y tutor id', () => {",
                  "  pm.expect(json.id).to.exist;",
                  "  pm.expect(json.email).to.eql(pm.environment.get('unique_email'));",
                  "  pm.expect(json.rol).to.eql('PADRE');",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('jwt_token', json.token);",
                  "pm.environment.set('tutor_id', json.id);",
                  "pm.environment.set('registered_email', json.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Perez\",\n  \"email\": \"{{unique_email}}\",\n  \"password\": \"{{registered_password}}\",\n  \"rol\": \"PADRE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
