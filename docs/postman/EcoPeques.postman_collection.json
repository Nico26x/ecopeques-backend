                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Niño creado vinculado al tutor autenticado', () => {",
                  "  pm.expect(json.id).to.exist;",
                  "  pm.expect(json.nombre).to.eql('Lucas');",
                  "  pm.expect(json.totalSemillas).to.eql(0);",
                  "  pm.expect(json.avatar).to.eql('avatar-lucas.png');",
                  "  pm.expect(json.grupo).to.eql('Grupo A');",
                  "  pm.expect(String(json.tutorId)).to.eql(String(pm.environment.get('tutor_id')));",
                  "});",
                  "pm.environment.set('nino_id', json.id);"
